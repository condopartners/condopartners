{
  "name": "condopartners",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@condopartners/api' --filter '@condopartners/web' dev",
    "dev:api": "bun run --filter '@condopartners/api' dev",
    "dev:web": "bun run --filter '@condopartners/web' dev",
    "dev:landing": "bun run --filter '@condopartners/landing' dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test deploy && bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:up": "docker-compose up -d db",
    "db:down": "docker-compose down",
    "db:generate": "bun run --filter '@condopartners/api' db:generate",
    "db:migrate": "bun run --filter '@condopartners/api' db:migrate",
    "db:studio": "bun run --filter '@condopartners/api' db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/bun": "^1.2.20",
    "typescript": "^5.9.2"
  }
}
