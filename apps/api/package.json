{
  "name": "@condopartners/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "build": "echo 'api: bun runs TypeScript directly; no emit step'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@condopartners/shared": "workspace:*",
    "@elysiajs/cors": "^1.3.3",
    "drizzle-orm": "^0.44.5",
    "elysia": "^1.3.21"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4"
  }
}
