# Deploy env — copie para deploy/.env (não commitado) e preencha no Portainer.
# Placeholders only. Never put real secrets in git.

# --- Postgres (stack interno; sem ports públicos) ---
POSTGRES_DB=condopartners
POSTGRES_USER=condopartners
POSTGRES_PASSWORD=change-me-replace-with-strong-password

# URL usada pela API dentro da rede Docker (host = nome do serviço)
DATABASE_URL=postgres://condopartners:change-me-replace-with-strong-password@postgres:5432/condopartners

# --- API ---
API_HOST=0.0.0.0
API_PORT=3000

# CORS + Better Auth (obrigatórios em prod/dev hospedados; nunca commitar secret real)
# prod:
WEB_ORIGIN=https://app.condopartners.com.br
BETTER_AUTH_URL=https://api.condopartners.com.br
# dev (use no stack/overlay dev):
# WEB_ORIGIN=https://app-dev.condopartners.com.br
# BETTER_AUTH_URL=https://api-dev.condopartners.com.br
BETTER_AUTH_SECRET=change-me-replace-with-random-string-at-least-32-chars

# SMTP (ativação de conta) — obrigatório em prod (NODE_ENV=production fail-fast).
# Ver docs/specs/auth-smtp-activation.md. Nunca commitar SMTP_PASS real.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me-smtp-user
SMTP_PASS=change-me-replace-with-smtp-password
SMTP_FROM=CondoPartners <noreply@condopartners.com.br>


# Path absoluto da pasta deploy/ no host Docker (overlays *.portainer.yml)
# DEPLOY_ROOT=/absolute/path/to/condopartners/deploy

# --- Web (build-arg Vite; URL pública da API por ambiente) ---
# prod:
VITE_API_URL=https://api.condopartners.com.br
# dev (use no stack dev):
# VITE_API_URL=https://api-dev.condopartners.com.br

# --- Domínios (referência / documentação; nginx usa server_name fixos) ---
DOMAIN_LANDING=condopartners.com.br
DOMAIN_WEB=app.condopartners.com.br
DOMAIN_API=api.condopartners.com.br
DOMAIN_WEB_DEV=app-dev.condopartners.com.br
DOMAIN_API_DEV=api-dev.condopartners.com.br

# --- nginx published ports (host) ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# dev tip: NGINX_HTTP_PORT=8080 / NGINX_HTTPS_PORT=8443

# --- Portainer image-based overlays (*.portainer.yml) ---
# Path absoluto no host até a pasta deploy/ (binds do nginx; evita ../ relativos).
DEPLOY_ROOT=/home/ubuntu/projetos/condopartners/deploy
# Imagens GHCR pinadas por SHA (CD — ver docs/specs/cd-continuous-deploy.md).
# Substitua <sha> pelo commit completo (40 hex). Tags móveis :prod / :dev existem
# além do SHA; o pin operacional é sempre sha-<fullsha>.
API_IMAGE=ghcr.io/condopartners/condopartners-api:sha-<fullsha>
WEB_IMAGE=ghcr.io/condopartners/condopartners-web:sha-<fullsha>
LANDING_IMAGE=ghcr.io/condopartners/condopartners-landing:sha-<fullsha>
# Fallback local (build-no-stack) se ainda não houver CD:
# API_IMAGE=condopartners-prod-api:latest
# WEB_IMAGE=condopartners-prod-web:latest
# LANDING_IMAGE=condopartners-prod-landing:latest
# (dev: condopartners-dev-api|web|landing:latest)

# --- TLS / certbot (hooks manuais; ver deploy/README.md) ---
CERTBOT_EMAIL=ops@example.com
