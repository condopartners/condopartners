# API
API_PORT=3000
API_HOST=0.0.0.0

# Database (local Docker Postgres — see docker-compose.yml)
DATABASE_URL=postgres://condopartners:condopartners@localhost:5432/condopartners

# Auth (Better Auth) — see docs/specs/auth-better-auth.md
# Generate a real secret locally (>=32 chars), never commit it:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# SMTP (ativação de conta) — see docs/specs/auth-smtp-activation.md
# Em produção (NODE_ENV=production) SMTP_HOST/PORT/FROM/USER/PASS são obrigatórios.
# Dev local: use Mailpit (ou similar) — ex. smtp://localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CondoPartners <noreply@localhost>
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Web (Vite)
VITE_API_URL=http://localhost:3000
