# API
API_PORT=3000
API_HOST=0.0.0.0

# Database (local Docker Postgres — see docker-compose.yml)
DATABASE_URL=postgres://condopartners:condopartners@localhost:5432/condopartners

# Auth (Better Auth) — see docs/specs/auth-better-auth.md
# Generate a real secret locally (>=32 chars), never commit it:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Super-admin — see docs/specs/super-admin-user-mgmt.md
# Optional CSV of user ids always treated as platform admins (bootstrap).
BETTER_AUTH_ADMIN_USER_IDS=

# Web (Vite)
VITE_API_URL=http://localhost:3000
